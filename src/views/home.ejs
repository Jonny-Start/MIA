<iframe title="" id="realtime-voice-invisible-iframe" src="http://localhost:3000" class="hidden"
allow="microphone"></iframe>

<script src="/js/siriwave.umd.min.js"></script>

<section id="logoHeader">
<img src="/img/icono_white.svg" alt="Isotipo de MIA">
<h2>mia</h2>
</section>

<%- include('./hooks/generateAndLogin.ejs') %>

<section id="content">
  <p>¡Hola! Soy Mia</p>
  <h1 class="animate__animated animate__pulse animate__repeat-2">¿Qué te gustaría aprender hoy <br /> sobre
    inteligencia Artificial?</h1>

  <div id="contentInput">
    <input type="search" name="search" id="search" placeholder="Envía un mensaje a Mia...">
    <button type="button" class="desktop" id="contentNext" onclick="javascript: window.location.href = '/goal' ">
      <i class="fa-solid fa-arrow-up"></i>
      <p>Siguiente</p>
    </button>
  </div>

  <div id="visualiser" class="hide"></div>
</section>

<div id="contentMic">
  <button type="button" id="buttonMic" class="iconMic" value="disconnect">
    <img src="/img/Mic_icon_no_containter.svg" id="iconMic" class="" alt="Isotipo de un microfono">
    <img src="/img/Pause_icon_no_container.svg" id="iconPause" class="hide" alt="Isotipo de pause">
  </button>
  <p id="textMic">Presiona para hablar con Mia</p>
  <button type="button" id="changeText" class="hide">
    <img src="/img/Keyboard_white.svg" alt="Isotipo de un teclado"> Continuar con texto
  </button>
</div>

<footer id="contentByPlatzi">
  <img src="/img/ByPlatzi_White.svg" alt="By Platzi" id="ByPlatzi"
    class="animate__animated animate__backInLeft animate__fast" />
</footer>


<script type="text/javascript" src="/js/scripts_home.js"></script>
<%# <button id="muteButton" aria-label="Toggle sound">
  <img src="/img/No_sound_white.svg" id="iconSound" class="hide" alt="Isotipo de solido">
  <img src="/img/Sound_white.svg" id="iconSoundCanceled" class="" alt="Isotipo de sonido cancelado">
</button> #%>