<%- include('./hooks/logoHeader.ejs') %>
<%- include('./hooks/generateAndLogin.ejs') %>

<section id="content">
    <h2>Aprende a crear agentes de inteligencia artificial con LangChain</h2>
    <div class="progress">
        <span>Tu progreso</span>
        <h3>0% Completado</h3>
        <div class="range-slider ">
            <input class="range-slider__range" type="range" value="0" min="0" max="100" step="10">
        </div>
    </div>
    <div>
        <div style="margin-top: 1em;">Este curso avanzado te llevará a través de la creación y uso de agentes de inteligencia artificial utilizando LangChain. Diseñado para profesionales con experiencia, aprenderás a desarrollar aplicaciones específicas que solucionen problemas complejos aprovechando la potencia de los modelos de lenguaje. Al finalizar, serás capaz de construir y desplegar agentes IA efectivos en diversos contextos.</div>
    </div>
    <div class="contentCards">
        <div class="cardgrey" onclick="redirect('themes')">
            <div class="card__img">
                <i class="fa-regular fa-file-lines"></i>
                <h4>Temas</h4>
                <p>Explora conceptos clave</p>
            </div>
        </div>
        <div class="cardgrey" onclick="redirect('challenges')">
            <div class="card__img">
                <i class="fa-regular fa-flag"></i>
                <h4>Retos</h4>
                <p>Desafía tu aprendizaje</p>
            </div>
        </div>
        <div class="cardgrey" onclick="redirect('doubt')">
            <div class="card__img">
                <i class="fa-solid fa-circle-question"></i>
                <h4>Dudas</h4>
                <p>Resuelve tus preguntas</p>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    document.documentElement.style.backgroundColor = '#ffffff'; // Cambia el color de fondo de <html>
    const cards = document.querySelectorAll('.cardgrey');

    function redirect(card) {
        if (card === 'themes') {
            return window.location.href = '/themes';
        }else if (card === 'challenges') {
            return window.location.href = '/challenges';
        }else if (card === 'doubt') {
            return window.location.href = '/doubt';
        }
    }

</script>
<%- include('./hooks/ByPlatzi.ejs') %>
